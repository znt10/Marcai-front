DATABASE_URL="postgresql://brutus_owner:owner@db:5432/brutus"
DATABASE_URL_APP="postgresql://brutus_app:app@db:5432/brutus"
DATABASE_URL_HOST="postgresql://brutus_owner:owner@localhost:5433/brutus"
DATABASE_URL_APP_HOST="postgresql://brutus_app:app@localhost:5433/brutus"
DATABASE_URL_TEST="postgresql://brutus_owner:owner@localhost:5433/brutus_test"
DATABASE_URL_APP_TEST="postgresql://brutus_app:app@localhost:5433/brutus_test"
DATABASE_URL_ADMIN="postgresql://brutus_admin:admin@db:5432/brutus"
DATABASE_URL_ADMIN_HOST="postgresql://brutus_admin:admin@localhost:5433/brutus"
DATABASE_URL_ADMIN_TEST="postgresql://brutus_admin:admin@localhost:5433/brutus_test"
NEXT_PUBLIC_DOMINIO_BASE="localhost"
# WhatsApp (Evolution API). A CHAVE alimenta dois serviços do compose: o
# `evolution` a exige como AUTHENTICATION_API_KEY e o `app` a manda como
# EVOLUTION_API_KEY. Gerar com
# `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`.
#
# A URL tem DUAS formas, como as do banco: o app roda no compose e fala com
# `http://evolution:8080` (definida lá, nome de serviço que só resolve dentro
# daquela rede); os scripts `whatsapp:*` rodam do host e falam com localhost.
#
# Sem a URL do app preenchida, todo envio cai no console.info — que é o modo de
# desenvolver sem número de verdade.
EVOLUTION_API_KEY=""
EVOLUTION_API_URL_HOST="http://localhost:8080"
EVOLUTION_INSTANCE="brutus"


# Segredo do agendador de lembretes. VAZIO NEGA TUDO, de propósito: sem ele a
# rota /api/cron/lembretes seria um disparador público de mensagens para a base
# inteira de clientes. Gerar com
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
CRON_SECRET=""

# Admin da plataforma (admin §4). Gerar com `npm run admin:hash -- "senha"` e
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
# O hash vai em BASE64: em claro ele tem `$`, que o @next/env e o Docker
# Compose expandem como variável — o valor chegaria truncado ao processo.
ADMIN_USUARIO=""
ADMIN_SENHA_HASH_B64=""
ADMIN_JWT_SECRET=""

# Sessao do barbeiro (painel §3). DIFERENTE do ADMIN_JWT_SECRET de proposito:
# e isso que faz cookie de admin nao abrir o painel, e vice-versa, sem
# nenhuma checagem escrita para esse fim. Gerar com
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
SESSAO_JWT_SECRET=""

# URL publica de onde o link de convite e montado. SEPARADA do
# NEXT_PUBLIC_DOMINIO_BASE de proposito: aquela guarda o dominio sem porta e
# sem esquema, porque e o que o slug.ts compara com o host da requisicao.
# Em producao: https://seudominio.com.br
NEXT_PUBLIC_URL_BASE="http://localhost:3000"
