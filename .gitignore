*.log

# env files — nunca versionar credenciais (.env.example é a exceção documentada)
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sistema operacional
Thumbs.db
desktop.ini

# editor
.vscode/*
!.vscode/extensions.json
.idea/

./docs
# workspace do subagent-driven-development (scratch)
.superpowers/
